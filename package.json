{
  "name": "@dzanek309/vhk-design-system",
  "version": "0.2.1",
  "description": "Vue 3 component library built for the VHK Figma design system",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dzanek309/vhk-design-system.git"
  },
  "homepage": "https://dzanek309.github.io/vhk-design-system/",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/index.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "dev": "vite",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "vue-tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build": "vite build"
  },
  "keywords": [
    "vhk",
    "vhk-design-system"
  ],
  "author": "Dzanek309",
  "license": "MIT",
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "devDependencies": {
    "@fontsource-variable/hahmlet": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/libre-caslon-display": "^5.3.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/vue3-vite": "^10.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.0",
    "jsdom": "^30.1.0",
    "prettier": "^3.9.8",
    "storybook": "^10.6.0",
    "storybook-addon-pseudo-states": "^10.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^5.1.1",
    "vitest": "^5.0.1",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.11"
  }
}
